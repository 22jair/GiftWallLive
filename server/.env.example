TIKTOK_USERNAME=nombre_del_creador
GIFTWALL_HOST=127.0.0.1
GIFTWALL_PORT=8081

# Spotify OAuth (crea una app en developer.spotify.com/dashboard)
# Registra exactamente esta URL de redirección en la app de Spotify.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8081/spotify/callback
SPOTIFY_SCOPES=user-read-playback-state,user-read-currently-playing,user-modify-playback-state

